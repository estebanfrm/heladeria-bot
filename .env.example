# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.

# App
APP_ENV=development
APP_BASE_URL=http://localhost:8000
# Relativo a la raíz del repo. Producción: seeds/heladeria.json (no se sube a git ni va en la imagen)
SEED_FILE=seeds/demo.json

# Base de datos (docker-compose la sobrescribe para el contenedor)
# Si ya tienes un Postgres local en el 5432, usa otro puerto (ej. 5433) en ambas líneas.
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://heladeria:heladeria@localhost:5432/heladeria

# WhatsApp Cloud API (Meta for Developers)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Números del personal que reciben los pedidos, separados por coma (formato 57XXXXXXXXXX)
STAFF_PHONES=

# IA: gemini | groq | ollama | openai  (todos vía la API compatible con OpenAI; anthropic: pendiente)
# Demo: gemini + gemini-3.5-flash-lite (capa gratis). Respaldo: groq + openai/gpt-oss-20b.
# Para comparar proveedores con los mensajes del chat real: uv run python -m app.ia.evaluar
IA_PROVIDER=gemini
IA_MODEL=gemini-3.5-flash-lite
IA_API_KEY=
# Opcional: otra URL compatible con OpenAI (ej. Ollama desde Docker: http://host.docker.internal:11434/v1)
IA_BASE_URL=
IA_TIMEOUT=20

# Límites
WEB_CHAT_MAX_MSGS_PER_SESSION=20

# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.

# App
APP_ENV=development
APP_BASE_URL=http://localhost:8000
SEED_FILE=../seeds/demo.json

# Base de datos (docker-compose la sobrescribe para el contenedor)
# Si ya tienes un Postgres local en el 5432, usa otro puerto (ej. 5433) en ambas líneas.
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://heladeria:heladeria@localhost:5432/heladeria

# WhatsApp Cloud API (Meta for Developers)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Números del personal que reciben los pedidos, separados por coma (formato 57XXXXXXXXXX)
STAFF_PHONES=

# IA: gemini | groq | ollama | openai | anthropic
IA_PROVIDER=gemini
IA_MODEL=
IA_API_KEY=

# Límites
WEB_CHAT_MAX_MSGS_PER_SESSION=20
